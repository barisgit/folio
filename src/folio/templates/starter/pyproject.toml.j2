[project]
name = "{{ project_slug | default('my-folio-project') }}"
version = "0.1.0"
description = "A folio document."
requires-python = ">=3.11"
dependencies = ["folio-dsl>=0.1"]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP", "PTH"]
ignore = ["B008"]
